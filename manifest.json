{
  "manifest_version": 2,
  "name": "Thunderbird BIMI Logo Viewer",
  "version": "1.1.1",
  "description": "Display BIMI logos in Thunderbird message headers.",
  "browser_specific_settings": {
    "gecko": {
      "id": "bimi-logo-viewer@example.com",
      "strict_min_version": "140.0"
    }
  },
  "permissions": [
    "messagesRead",
    "accountsRead"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "experiment_apis": {
    "bimiHeader": {
      "schema": "schema-header.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "bimiHeader"
          ]
        ],
        "script": "implementation-header.js"
      }
    },
    "bimiList": {
      "schema": "schema-list.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "bimiList"
          ]
        ],
        "script": "implementation-list.js"
      }
    }
  },
  "message_display_action": {
    "default_title": "BIMI Info",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "32": "icons/icon-32.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  }
}